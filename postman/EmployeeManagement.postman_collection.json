  "item": [
    {
      "name": "1. Happy path (valid requests)",
      "item": [
        {
          "name": "GET all employees",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is a list\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "POST create valid employee",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new unique email every run, so the collection can be run again and again",
                  "pm.collectionVariables.set(\"email\", `alex.${Date.now()}@bdo.mu`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Response has a generated id\", () => pm.expect(body.id).to.be.a(\"number\"));",
                  "pm.test(\"Location header points to the new employee\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(`/api/employees/${body.id}`));",
                  "// Remember the id for the next requests",
                  "pm.collectionVariables.set(\"employeeId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alex\",\n  \"middle_name\": \"James\",\n  \"last_name\": \"Brown\",\n  \"date_of_birth\": \"1995-06-15\",\n  \"email\": \"{{email}}\",\n  \"department\": \"Information Technology\",\n  \"job_title\": \"Software Engineer\",\n  \"status\": \"Active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET employee by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the employee we created\", () => pm.expect(body.id).to.eql(Number(pm.collectionVariables.get(\"employeeId\"))));",
                  "pm.test(\"Fields use snake_case and status is text\", () => { pm.expect(body).to.have.property(\"first_name\"); pm.expect(body.status).to.eql(\"Active\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "PUT update employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
