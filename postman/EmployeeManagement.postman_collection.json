                "{{employeeId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Alex\",\n  \"middle_name\": \"James\",\n  \"last_name\": \"Brown\",\n  \"date_of_birth\": \"1995-06-15\",\n  \"email\": \"{{email}}\",\n  \"department\": \"Information Technology\",\n  \"job_title\": \"Senior Software Engineer\",\n  \"status\": \"Inactive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET employee by id (check update)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Job title was updated\", () => pm.expect(body.job_title).to.eql(\"Senior Software Engineer\"));",
                  "pm.test(\"Status was updated\", () => pm.expect(body.status).to.eql(\"Inactive\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}"
              ]
            },
            "description": ""
